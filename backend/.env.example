# Copy to backend/.env and fill in. Never commit .env.

NODE_ENV=production
HOST=127.0.0.1
PORT=17101
# Public origin of the portal; state-changing API calls from any other origin are refused.
APP_ORIGIN=https://alembicdigilabs.com

# MariaDB: app user (data only) and migration user (schema changes). See deploy/mariadb/setup.sql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aadhaar_portal
DB_USER=aadhaar_app
DB_PASSWORD=
DB_MIGRATION_USER=aadhaar_migrator
DB_MIGRATION_PASSWORD=

# At least 32 random characters, e.g. `openssl rand -base64 48`. Changing it invalidates unused sign-in codes.
OTP_SECRET=
# At least 32 random characters, e.g. `openssl rand -base64 48`. Derives the shared booking
# links and signs short-lived file links. Changing it replaces every booking link.
LINK_SECRET=
# Encrypts Aadhaar files at rest: exactly 32 random bytes, base64, e.g. `openssl rand -base64 32`.
# Keep a safe copy: without it stored files cannot be read.
FILE_ENCRYPTION_KEY=

# Hostinger SMTP for support@alembic.co.in
MAIL_TRANSPORT=smtp
MAIL_FROM=Aadhaar Collection Portal <support@alembic.co.in>
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@alembic.co.in
SMTP_PASSWORD=

# Tests (npm test): a separate database whose name ends in _test. Every table in it is emptied
# before each test. Defaults to the DB_* server and user above, database aadhaar_portal_test.
# TEST_DB_NAME=aadhaar_portal_test
# TEST_DB_USER=
# TEST_DB_PASSWORD=

# Optional
# SESSION_IDLE_MINUTES=120
# SESSION_ABSOLUTE_HOURS=12
# STORAGE_DIR=storage
# EMPLOYEE_SESSION_MINUTES=30
# EMPLOYEE_MAX_CODES_PER_IP_HOUR=100
# LOG_LEVEL=info
